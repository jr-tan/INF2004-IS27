diff --git a/testing/line_sim/line_sim.c b/testing/line_sim/line_sim.c
index e284402..e22f1ae 100644
--- a/testing/line_sim/line_sim.c
+++ b/testing/line_sim/line_sim.c
@@ -79,6 +79,34 @@ static int near_idx(double x, double y, int hint, double *dmin)
 static double LINE_W = 19.0, BLUR = 3.0;
 static double EDGE_X = 0;		/* edge layout: start on the line's edge */
 static double DEADBAND = 20, TAU = 0.08; static int LAT_TICKS = 1;
+/* FWDUTY=1: firmware duty map as it was (floor D0+30, kick on every
+   wheel start); FWDUTY=2: fixed map (floor only limits trim, kick only
+   from rest).  0 = ideal deadband model (DEADBAND). */
+static int FWDUTY = 0;
+#define FW_D0 120
+#define FW_K 986
+#define FW_KICK 120
+#define FW_KICK_MS 250
+static double fw_speed(double set, int m, int ms, double other_set)
+{
+	static double prev[2]; static int t_start[2], kick_ok[2];
+	double sp = fabs(set), d, base;
+	if (ms == 0) { prev[0] = prev[1] = 0; t_start[0] = t_start[1] = -100000; }
+	if (prev[m] == 0 && sp != 0) {
+		t_start[m] = ms;
+		kick_ok[m] = FWDUTY == 1 || fabs(other_set) < 5 || t_start[m ^ 1] == ms;
+	}
+	prev[m] = sp;
+	if (sp < 5) return 0;			/* braked */
+	base = FW_D0 + sp * FW_K / 1000.0;
+	d = base;
+	if (ms - t_start[m] < FW_KICK_MS && kick_ok[m]) d += FW_KICK;
+	if (FWDUTY == 1) { if (d < FW_D0 + 30) d = FW_D0 + 30; }
+	else { double fl = base < FW_D0 + 30 ? base : FW_D0 + 30; if (d < fl) d = fl; }
+	/* real wheel: stalls below D0 (+ a little static friction) */
+	if (d < FW_D0 + 3) return 0;
+	return (set < 0 ? -1 : 1) * (d - FW_D0) * 1000.0 / FW_K;
+}
 static int sense(double x, double y, int hint)
