 	  if ((e = getenv("ONLYNEW"))) print = -print; }
 	printf("deadband %.0f mm/s, tau %.2f s, blur %.1f mm, latency %d ticks, speed %d\n", DEADBAND, TAU, BLUR, LAT_TICKS, k.speed);
 	printf("Firmware defaults:\n");
