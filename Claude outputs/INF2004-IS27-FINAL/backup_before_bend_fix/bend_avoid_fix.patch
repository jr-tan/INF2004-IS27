+		if (FWDUTY) {
+			/* the firmware ramp rounds to whole mm/s every 20 ms */
+			wl = fw_speed(cl, 0, ms, cr);
+			wr = fw_speed(cr, 1, ms, cl) * car->mis;
+		}
 		vl += (wl - vl) * (0.001 / TAU);
