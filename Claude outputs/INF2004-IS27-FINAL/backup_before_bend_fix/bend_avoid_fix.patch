 }
+/* straight legs: steer back to leg_head with the encoder heading.
+   Open loop, the legs curved with any left/right motor difference and
+   the 3-5 deg a spin over- or under-shoots, so the car met the line
+   far from where the box route expected.  Call every tick of a leg. */
+#define AV_HOLD_DIV		300	/* correction mm/s = error (0.1 deg) * speed / this */
+LOCAL void leg_hold(void)
+{
+	W err;
+	INT corr;
+
+	if (!motion_heading_ok()) return;	/* encoder fault: stay open loop */
+	err = leg_head - motion_heading_d10();	/* + = turn left */
+	corr = (INT)((err * leg_mms) / AV_HOLD_DIV);
+	corr = CLAMP(corr, -leg_mms / 2, leg_mms / 2);
+	motion_wheels(MOT_OWNER_MISSION, leg_mms - corr, leg_mms + corr);
+}
